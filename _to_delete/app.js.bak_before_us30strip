const LOCAL_HIDDEN_BUILTIN_KEY = 'eaDashboardHiddenBuiltin';
function loadLocalHiddenBuiltin(){
  try{ return new Set(JSON.parse(localStorage.getItem(LOCAL_HIDDEN_BUILTIN_KEY) || '[]')); }
  catch(e){ return new Set(); }
}
function saveLocalHiddenBuiltin(){
  try{
    const onlyBuiltin = [...deletedCodes].filter(c => TOP10_ORDER.includes(c));
    localStorage.setItem(LOCAL_HIDDEN_BUILTIN_KEY, JSON.stringify(onlyBuiltin));
  } catch(e){}
}

async function initAutosaveDB(){
  loadLocalHiddenBuiltin().forEach(c => deletedCodes.add(c));
  try{
    const rows = await apiListEAs();
    rows.forEach(row=>{
      CUSTOM[row.id] = {
        name: row.name,
        short: row.short_label,
        orig_lot: Number(row.orig_lot),
        orig_deposit: Number(row.orig_deposit),
        t: (row.trades || []).map(pt => pt.t),
        p: (row.trades || []).map(pt => pt.p),
        sourceCode: row.source_code || null,
        mq5Name: row.name,
        flags: (row.flags && Object.keys(row.flags).length) ? row.flags : null,
      };
      customOrder.push(row.id);
      if (row.deleted_at) deletedCodes.add(row.id);
      if (row.dismissed) dismissedChips.add(row.id);
    });
  } catch(e){
    console.error('โหลดรายชื่อ EA จาก Supabase ไม่สำเร็จ', e);
    showStatus('เชื่อมต่อฐานข้อมูล Supabase ไม่สำเร็จ — ตรวจสอบ URL/Key ใน supabaseClient.js (' + e.message + ')', false);
  }
  try{
    const drafts = await apiListDrafts();
    eaDrafts = drafts.map(d => ({
      id: d.id,
      name: d.name,
      baseCode: d.base_code,
      baseLabel: d.base_label,
      baseFlags: d.base_flags || {},
      newFlags: d.new_flags || {},
      addedIds: d.added_ids || [],
      removedIds: d.removed_ids || [],
      baseSourceCode: d.base_source_code || null,
      baseMq5Name: d.base_mq5_name || null,
      createdAt: d.created_at ? new Date(d.created_at).getTime() : Date.now(),
    }));
  } catch(e){
    console.error('โหลดใบสเปคจาก Supabase ไม่สำเร็จ', e);
  }
}

