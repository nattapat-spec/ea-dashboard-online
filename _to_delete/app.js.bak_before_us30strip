function generateEACodeFile(id){
  const d = eaDrafts.find(x=>x.id===id);
  if(!d) return;
  if(d.baseCode !== 'MASTER'){
    showCreateStatus('ดาวน์โหลดไฟล์ .mq5 พร้อมตั้งค่าได้เฉพาะใบสเปคที่สร้างจาก "Master Template" เท่านั้น เพราะไฟล์ต้นแบบอื่นไม่มีโครงสร้าง input ที่ตรงกัน — เลือก EA ต้นแบบเป็น Master Template แล้วสร้างใบสเปคใหม่', false);
    return;
  }
  let code = d.baseSourceCode || MASTER_TEMPLATE.sourceCode;
  if(!code){ showCreateStatus('ไม่พบซอร์สโค้ดต้นแบบ', false); return; }
  const unsupported = [];
  Object.keys(d.newFlags).forEach(fid=>{
    const map = MASTER_FEATURE_MAP[fid];
    const want = !!d.newFlags[fid];
    const baseHad = !!d.baseFlags[fid];
    if(!map){
      if(want !== baseHad) unsupported.push(fid);
      return;
    }
    if(map.type === 'bool'){
      const inputs = map.inputs || [map.input];
      inputs.forEach(inputName=>{
        const re = new RegExp('(input\\s+bool\\s+' + inputName + '\\s*=\\s*)(true|false)');
        code = code.replace(re, '$1' + (want ? 'true' : 'false'));
      });
    } else if(map.type === 'timeframe'){
      const re = new RegExp('(input\\s+ENUM_TIMEFRAMES\\s+' + map.input + '\\s*=\\s*)(PERIOD_[A-Z0-9]+)');
      code = code.replace(re, '$1' + (want ? map.onValue : map.offValue));
    }
  });
  const header = '//+---------------------------------------------------+\n' +
                 '//| Auto-generated by EA Dashboard — สร้าง EA ใหม่\n' +
                 '//| ใบสเปค: ' + d.name + '\n' +
                 '//| จากต้นแบบ: ' + d.baseLabel + '\n' +
                 '//| สร้างเมื่อ: ' + new Date().toLocaleString('th-TH') + '\n' +
                 '//| ⚠ ยังไม่เคย Compile/Backtest จริง — ต้องเปิดใน MetaEditor กด F7\n' +
                 '//| ให้ผ่านก่อน แล้วรัน Strategy Tester ทดสอบให้ครบ ก่อนใช้บัญชีจริง\n' +
                 '//+---------------------------------------------------+\n';
  code = header + code;
  const blob = new Blob([code], {type:'text/plain'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const fname = (d.name || 'EA_Generated').replace(/[^a-zA-Z0-9_\-]/g,'_') + '.mq5';
  a.href = url; a.download = fname;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(()=>URL.revokeObjectURL(url), 2000);
  if(unsupported.length){
    const names = unsupported.map(x=>(FEATURES.find(f=>f.id===x)||{}).label||x).join(', ');
    showCreateStatus('ดาวน์โหลด ' + fname + ' แล้ว — แต่มีบางคุณสมบัติที่ไฟล์ต้นแบบยังไม่มีสวิตช์รองรับ (ไม่ถูกปรับในไฟล์นี้): ' + names + ' — ตรวจสอบเพิ่มเองก่อนใช้จริง', false);
  } else {
    showCreateStatus('ดาวน์โหลด ' + fname + ' สำเร็จ — เปิดใน MetaEditor แล้ว Compile (F7) + Backtest ให้ผ่านก่อนใช้จริงเสมอ', true);
  }
}

