next_dt;\n   TimeToStruct(currentBar, curr_dt);\n   TimeToStruct(currentBar - PeriodSeconds(InpTimeframe), prev_dt);\n   if(curr_dt.day != prev_dt.day) return;\n   TimeToStruct(currentBar + PeriodSeconds(InpTimeframe), next_dt);\n   if(next_dt.day != curr_dt.day) return;\n\n   bool isWednesday = (curr_dt.day_of_week == WEDNESDAY);   // [WED] S1 หยุดเสมอ, S2 เลือกได้\n\n   // [SESS] Session Filter\n   if(InpUseSessionFilter) {\n      if(curr_dt.hour < InpSessionStart || curr_dt.hour >= InpSessionEnd) return;\n   }\n\n   // [DLL] Daily Loss Limit\n   if(InpUseDailyLossLimit) {\n      double todayPnL = GetTodayPnL();\n      if(todayPnL <= -InpMaxDailyLossUSD) {\n         static datetime lastLimitAlert = 0;\n         if(currentBar != lastLimitAlert) {\n            SendTelegram(\"🛑 Daily Loss -$\" + DoubleToString(InpMaxDailyLossUSD,0) + \" หยุดวันนี้\");\n            lastLimitAlert = currentBar;\n         }\n         return;\n      }\n   }\n\n   // [CLC] Consecutive Loss Cooldown\n   if(IsCooldown()) return;\n\n   if(adx1 < InpADXThreshold) return;\n\n   // [ADXR] ADX Rising Filter\n   if(InpUseADXRising) {\n      if(ArraySize(adxBuf) <= InpADXRisingBars) return;\n      if(adxBuf[1] <= adxBuf[InpADXRisingBars]) return;\n   }\n\n   // [GATE] Volatility Gate\n   double curATRPts, avgATRPts;\n   if(!IsVolatilityOK(curATRPts, avgATRPts)) {\n      static datetime lastVolAlert = 0;\n      if(currentBar != lastVolAlert) {\n         SendTelegram(\"🌪️ Volatility Gate: ATR=\" + DoubleToString(curATRPts,0) + \"pts > เฉลี่ย → ข้ามรอบนี้\");\n         lastVolAlert = currentBar;\n      }\n      return;\n   }\n\n   // [GATE] Spread Gate\n   double curSpreadPts, avgSpreadPts;\n   if(!IsSpreadOK(curSpreadPts, avgSpreadPts)) {\n      static datetime lastSpreadAlert = 0;\n      if(currentBar != lastSpreadAlert) {\n         SendTelegram(\"↔️ Spread Gate: spread=\" + DoubleToString(curSpreadPts,0) + \"pts > เฉลี่ย → ข้ามรอบนี้\");\n         lastSpreadAlert = currentBar;\n      }\n      return;\n   }\n\n   // [NEWS] News Time Block\n   if(IsNewsTime()) {\n      static datetime lastNewsAlert = 0;\n      if(currentBar != lastNewsAlert) {\n         SendTelegram(\"📰 News Time Block ±\" + IntegerToString(InpNewsBufferMins) + \"min → งด trade ฮับ\");\n         lastNewsAlert = currentBar;\n      }\n      return;\n   }\n\n   // [H4] H4 Trend Filter — 1=uptrend(เปิดเฉพาะ BUY) -1=downtrend(เปิดเฉพาะ SELL) 0=ไม่กรอง\n   int h4Trend = GetH4Trend();\n\n   double effDIGap = EffectiveDIGap();   // [DI12]\n\n   // --- System 1: เศษราคา ---\n   if(InpEnableS1 && !isWednesday) {    // [S1] [WED: S1 หยุดวันพุธเสมอ]\n      if(InpAllowOverlap || !HasAnyOpenPosition()) {   // [OVL]\n         int sys1_sig = 0; double sys1_tgt = 0.0;\n         double remain = fmod(close1, 1000.0);\n         if(remain < 0) remain += 1000.0;\n         double base = close1 - remain;\n         if(close1 > open1) {\n            if     (remain>=245.0&&remain<=260.0){sys1_tgt=base+200.0;sys1_sig= 1;}\n            else if(remain>=445.0&&remain<=460.0){sys1_tgt=base+400.0;sys1_sig= 1;}\n            else if(remain>=645.0&&remain<=660.0){sys1_tgt=base+600.0;sys1_sig= 1;}\n            else if(remain>=845.0&&remain<=860.0){sys1_tgt=base+800.0;sys1_sig= 1;}\n         } else if(close1 < open1) {\n            if     (remain>=140.0&&remain<=155.0){sys1_tgt=base+200.0;sys1_sig=-1;}\n            else if(remain>=340.0&&remain<=355.0){sys1_tgt=base+400.0;sys1_sig=-1;}\n            else if(remain>=540.0&&remain<=555.0){sys1_tgt=base+600.0;sys1_sig=-1;}\n            else if(remain>=740.0&&remain<=755.0){sys1_tgt=base+800.0;sys1_sig=-1;}\n         }\n         if(sys1_sig != 0 && !HasOpenPosition(\"-S1\")) {\n            bool ma_ok = (sys1_sig==1)?(close1>ma1):(close1<ma1);\n            bool di_ok = (sys1_sig==1)?(diP1>diM1+effDIGap):(diM1>diP1+effDIGap);\n            bool h4_ok = (h4Trend==0) || (sys1_sig==1 ? h4Trend==1 : h4Trend==-1);   // [H4]\n            if(ma_ok && di_ok && h4_ok) {\n               double price = (sys1_sig==1)?SymbolInfoDouble(_Symbol,SYMBOL_ASK):SymbolInfoDouble(_Symbol,SYMBOL_BID);\n               double sl = NormalizeDouble((sys1_sig==1)?sys1_tgt-50.0:sys1_tgt+50.0,_Digits);\n               double risk = MathAbs(price-sl);\n               if(risk > 0) {\n                  double tp = NormalizeDouble((sys1_sig==1)?price+(risk*InpFinalRR):price-(risk*InpFinalRR),_Digits);\n                  double lot = CalcLot(risk/_Point);   // [RLOT]\n                  string comment = \"MASTER-S1 ADX=\"+DoubleToString(adx1,1)+\" DI=\"+DoubleToString(MathAbs(diP1-diM1),1);\n                  bool sent = (sys1_sig==1)?trade.Buy(lot,_Symbol,price,sl,tp,comment):trade.Sell(lot,_Symbol,price,sl,tp,comment);\n                  if(sent) SendTelegram(\"📊 [S1] \"+(sys1_sig==1?\"BUY 🟢\":\"SELL 🔴\")\n                     +\"\\nEntry:\"+DoubleToString(price,_Digits)+\" SL:\"+DoubleToString(sl,_Digits)+\" TP:\"+DoubleToString(tp,_Digits)+\" Lot:\"+DoubleToString(lot,2));\n               }\n            }\n         }\n      }\n   }\n\n   // --- System 2: RSI + MA cross + ATR SL ---\n   bool s2WedOk = InpS2AllowTradeWednesday || !isWednesday;   // [WED]\n   if(InpEnableS2 && s2WedOk) {    // [S2]\n      if(InpAllowOverlap || !HasAnyOpenPosition()) {   // [OVL]\n         bool rsi_cross_up   = (rsi2 < InpRSIBuyLevel  && rsi1 >= InpRSIBuyLevel);\n         bool rsi_cross_down = (rsi2 > InpRSISellLevel && rsi1 <= InpRSISellLevel);\n         bool ma_cross_up    = (close2 < ma2 && close1 > ma1);\n         bool ma_cross_down  = (close2 > ma2 && close1 < ma1);\n         bool rsi_ceiling_ok = (!InpUseRSICeiling) || (rsi1 < InpRSIBuyCeiling);   // [RSIC]\n         int sys2_sig = 0;\n         if(rsi_cross_up   && ma_cross_up   && rsi_ceiling_ok) sys2_sig =  1;\n         if(rsi_cross_down && ma_cross_down)                   sys2_sig = -1;\n         if(sys2_sig != 0 && !HasOpenPosition(\"-S2\")) {\n            bool di_ok = (sys2_sig==1)?(diP1>diM1+effDIGap):(diM1>diP1+effDIGap);\n            bool h4_ok = (h4Trend==0) || (sys2_sig==1 ? h4Trend==1 : h4Trend==-1);   // [H4]\n            if(di_ok && h4_ok) {\n               double price  = (sys2_sig==1)?SymbolInfoDouble(_Symbol,SYMBOL_ASK):SymbolInfoDouble(_Symbol,SYMBOL_BID);\n               double s2sl   = GetS2SLPoints();   // [ATR]\n               double sl     = NormalizeDouble((sys2_sig==1)?price-s2sl:price+s2sl,_Digits);\n               double risk   = MathAbs(price-sl);\n               double tp     = NormalizeDouble((sys2_sig==1)?price+(risk*InpFinalRR):price-(risk*InpFinalRR),_Digits);\n               double lot    = CalcLot(s2sl);   // [RLOT]\n               string comment = \"MASTER-S2 ATR_SL=\"+DoubleToString(s2sl,0)+\"pts RSI=\"+DoubleToString(rsi1,1);\n               bool sent = (sys2_sig==1)?trade.Buy(lot,_Symbol,price,sl,tp,comment):trade.Sell(lot,_Symbol,price,sl,tp,comment);\n               if(sent) SendTelegram(\"📊 [S2] \"+(sys2_sig==1?\"BUY 🟢\":\"SELL 🔴\")\n                  +\"\\nEntry:\"+DoubleToString(price,_Digits)+\" SL:\"+DoubleToString(sl,_Digits)+\" TP:\"+DoubleToString(tp,_Digits)+\" Lot:\"+DoubleToString(lot,2));\n            }\n         }\n      }\n   }\n}\n",
