function detectFlagsFromSource(src){
  const flags = {};
  FEATURES.forEach(f=>{
    const patterns = FEAT_KEYWORDS[f.id] || [];
    flags[f.id] = patterns.some(re => re.test(src)) ? 1 : 0;
  });
  // "DI Gap ≥12" ต้องเช็คค่า threshold จริง ไม่ใช่แค่เจอคำว่า DI Gap ในโค้ด
  // (EA หลายตัวมี DI Gap filter แต่ตั้งค่าต่ำกว่า 12 มาก เช่น 5 ซึ่งไม่เข้าเกณฑ์นี้)
  if (flags.DI12){
    const m = src.match(/Inp\w*DI\w*Gap\w*\s*=\s*([\d.]+)/i) || src.match(/DI\w*Gap\w*\s*[><=]{1,2}\s*([\d.]+)/i);
    flags.DI12 = (m && parseFloat(m[1]) >= 12) ? 1 : 0;
  }
  return flags;
}
/* ค่า DI Gap (points) จริงของแต่ละ EA ในตัวใน Top10 — อ่านมาจากไฟล์ .mq5 ต้นฉบับของแต่ละตัวโดยตรง
   (E15 = v1.93_TS200_DI12.mq5 ใช้ 12, ที่เหลือใช้ 5) ใช้แทนการเช็ค ≥12 แบบ boolean เดิม
   เพื่อโชว์ตัวเลขจริงในตารางเปรียบเทียบให้ตรงกับ EA แต่ละตัว */
const DI_GAP_VALUES = {E09:5, E36:5, E23:5, E29:5, E39:5, E45:5, E40:5, E33:5, E37:5, E15:12};
function getDIGapValue(code){
  if (DI_GAP_VALUES[code] !== undefined) return DI_GAP_VALUES[code];
  const d = getEA(code);
  if (d && d.sourceCode){
    const m = d.sourceCode.match(/Inp\w*DI\w*Gap\w*\s*=\s*([\d.]+)/i) || d.sourceCode.match(/DI\w*Gap\w*\s*[><=]{1,2}\s*([\d.]+)/i);
    if (m) return parseFloat(m[1]);
  }
  return null;
}
