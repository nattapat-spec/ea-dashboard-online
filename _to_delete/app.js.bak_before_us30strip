/* ============ date bucket keys ============ */
function dayKey(ts){ const d=new Date(ts); return `${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,'0')}-${String(d.getUTCDate()).padStart(2,'0')}`; }
function isoWeekKey(ts){
  const d0 = new Date(ts);
  const date = new Date(Date.UTC(d0.getUTCFullYear(), d0.getUTCMonth(), d0.getUTCDate()));
  const dayNum = (date.getUTCDay() + 6) % 7;
  date.setUTCDate(date.getUTCDate() - dayNum + 3);
  const firstThursday = new Date(Date.UTC(date.getUTCFullYear(),0,4));
  const firstDayNum = (firstThursday.getUTCDay()+6)%7;
  firstThursday.setUTCDate(firstThursday.getUTCDate() - firstDayNum + 3);
  const weekNum = 1 + Math.round((date - firstThursday) / (7*24*3600*1000));
  return `${date.getUTCFullYear()}-W${String(weekNum).padStart(2,'0')}`;
}
function monthKey(ts){ const d=new Date(ts); return `${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,'0')}`; }
function quarterKey(ts){ const d=new Date(ts); return `${d.getUTCFullYear()}-Q${Math.floor(d.getUTCMonth()/3)+1}`; }
function yearKey(ts){ return String(new Date(ts).getUTCFullYear()); }
const KEYFN = {daily:dayKey, weekly:isoWeekKey, monthly:monthKey, quarterly:quarterKey, yearly:yearKey};

function consecLossStats(profits){
  let bestCount=0, bestSum=0, curCount=0, curSum=0;
  profits.forEach(p=>{
    if(p<0){ curCount++; curSum+=p; if(curCount>bestCount || (curCount===bestCount && curSum<bestSum)){bestCount=curCount; bestSum=curSum;} }
    else { curCount=0; curSum=0; }
  });
  return {count: bestCount, dollar: Math.round(bestSum*100)/100};
}
function bucketStats(trades, keyfn){
  const buckets = {};
  trades.forEach(tr=>{
    const k = keyfn(tr.t);
    if(!buckets[k]) buckets[k]=[];
    buckets[k].push(tr.p);
  });
  const keys = Object.keys(buckets).sort();
  return keys.map(k=>{
    const profits = buckets[k];
    const n = profits.length;
    const wins = profits.filter(p=>p>0).length;
    const net = profits.reduce((a,b)=>a+b,0);
    const cl = consecLossStats(profits);
    let cum=0, peak=0, dd=0;
    profits.forEach(p=>{ cum+=p; if(cum>peak) peak=cum; const trough=peak-cum; if(trough>dd) dd=trough; });
    return {period:k, trades:n, net_profit:Math.round(net*100)/100, win_rate_pct:Math.round(1000*wins/n)/10, max_consec_losses:cl.count, max_consec_losses_dollar:cl.dollar, dd_intraperiod:Math.round(dd*100)/100};
  });
}
function simulate(code, lot, capital){
  const d = getEA(code);
  const useLot = lot || d.orig_lot;
  const useCap = capital || d.orig_deposit;
  const scale = useLot / d.orig_lot;
  const trades = d.t.map((t,i)=>({t, p: Math.round(d.p[i]*scale*100)/100}));
  let equity = useCap, peak = useCap, maxDD=0, maxDDPct=0, minEquity=useCap, wentNegative=false;
  let maxDDPoint = null;
  const eqCurve = [{t: trades[0]?trades[0].t:0, v:useCap}];
  trades.forEach(tr=>{
    equity += tr.p;
    if (equity<minEquity) minEquity=equity;
    if (equity<0) wentNegative=true;
    if (equity>peak) peak=equity;
    const dd = peak-equity;
    const ddPct = peak>0?(dd/peak*100):0;
    if (dd>maxDD) { maxDD=dd; maxDDPoint = {t: tr.t, v: equity}; }
    if (ddPct>maxDDPct) maxDDPct=ddPct;
    eqCurve.push({t:tr.t, v:equity});
  });
  const netProfit = equity-useCap;
  const profits = trades.map(t=>t.p);
  const wins = profits.filter(p=>p>0).length;
  const winRate = profits.length ? wins/profits.length*100 : 0;
  const grossProfit = profits.filter(p=>p>0).reduce((a,b)=>a+b,0);
  const grossLoss = Math.abs(profits.filter(p=>p<0).reduce((a,b)=>a+b,0));
  const pf = grossLoss>0 ? grossProfit/grossLoss : (grossProfit>0?Infinity:0);
  const cl = consecLossStats(profits);
  return {
    code, short: d.short, lot: useLot, capital: useCap, trades,
    netProfit, netProfitPct: useCap>0?(netProfit/useCap*100):0,
    maxDD, maxDDPct, winRate, pf, mcl: cl.count, mclDollar: cl.dollar,
    totalTrades: profits.length, minEquity, wentNegative, eqCurve, maxDDPoint,
  };
}

