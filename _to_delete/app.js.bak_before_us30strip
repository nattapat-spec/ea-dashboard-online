async function handleUpload(){
  const fileInput = document.getElementById('fileInput');
  const eaFileInput = document.getElementById('eaFileInput');
  const labelInput = document.getElementById('labelInput');
  const file = fileInput.files[0];
  if (!file){ showStatus('กรุณาเลือกไฟล์ผลเทสก่อน', false); return; }
  showStatus('กำลังอ่านไฟล์...', true);
  try {
    const ext = file.name.split('.').pop().toLowerCase();
    let parsed;
    if (ext === 'xlsx') parsed = await parseXlsxReport(file);
    else { const text = await readAsSmartText(file); parsed = parseHtmlReport(text); }

    let sourceCode = null, mq5Name = null;
    const eaFile = eaFileInput.files[0];
    if (eaFile){
      sourceCode = await readAsSmartText(eaFile);
      mq5Name = eaFile.name;
    }
    const flags = readCheckedFeatFlags();
    const label = labelInput.value.trim() || file.name.replace(/\.(html?|xlsx)$/i,'');

    showStatus('กำลังอัพโหลดขึ้น Supabase...', true);
    const trades = parsed.t.map((t,i)=>({t, p: parsed.p[i]}));
    const row = await apiUploadEA(eaFile || null, {
      name: mq5Name || file.name,
      short_label: label,
      family: null,
      source_code: sourceCode,
      orig_lot: parsed.orig_lot,
      orig_deposit: parsed.orig_deposit,
      trades,
      flags: flags || {},
      di_gap_value: null,
