/* ============ UPLOAD (shared by both tabs) ============ */
function parseNum(s){
  if (s===null || s===undefined) return null;
  if (typeof s === 'number') return s;
  s = String(s).trim().replace(/&nbsp;/g,' ').replace(/\s/g,'').replace(/,/g,'');
  if (s==='') return null;
  const v = parseFloat(s);
  return isNaN(v) ? null : v;
}
function parseDateMT5(s){
  if (!s) return null;
  s = String(s).trim();
  const parts = s.split(' ');
  const datePart = parts[0], timePart = parts[1];
  if (!datePart) return null;
  const dp = datePart.split('.').map(Number);
  if (dp.length < 3 || dp.some(isNaN)) return null;
  const [y,mo,da] = dp;
  let h=0,mi=0,se=0;
  if (timePart){ const tp = timePart.split(':').map(Number); h=tp[0]||0; mi=tp[1]||0; se=tp[2]||0; }
  const t = Date.UTC(y, mo-1, da, h, mi, se);
  return isNaN(t) ? null : t;
}
async function readAsSmartText(file){
  const buf = await file.arrayBuffer();
  const bytes = new Uint8Array(buf.slice(0,4));
  let encoding = 'utf-8';
  if (bytes[0]===0xFF && bytes[1]===0xFE) encoding = 'utf-16le';
  else if (bytes[0]===0xFE && bytes[1]===0xFF) encoding = 'utf-16be';
  return new TextDecoder(encoding).decode(buf);
}
function parseHtmlReport(text){
  const idx = text.indexOf('>Deals<');
  if (idx === -1) throw new Error('ไม่พบตาราง "Deals" ในไฟล์ — ต้อง export รายงานแบบ Detailed/Full Report จาก Strategy Tester');
  const section = text.slice(idx);
  const rowRe = /<tr[^>]*>([\s\S]*?)<\/tr>/g;
  const cellRe = /<td[^>]*>([\s\S]*?)<\/td>/g;
  let rowMatch;
  const closed = [];
  let origLot = null, origDeposit = null;
  while ((rowMatch = rowRe.exec(section))) {
    const rowHtml = rowMatch[1];
    const cells = [];
    let cellMatch;
    cellRe.lastIndex = 0;
    while ((cellMatch = cellRe.exec(rowHtml))) cells.push(cellMatch[1].replace(/<[^>]+>/g,'').trim());
    if (cells.length < 13) continue;
    const timeS = cells[0], typ = cells[3], direction = cells[4], vol = cells[5], comm = cells[8], swap = cells[9], profit = cells[10];
    if (typ === 'balance' && origDeposit === null) { const dep = parseNum(profit); if (dep !== null) origDeposit = dep; continue; }
    if (direction !== 'in' && direction !== 'out') continue;
    if (direction === 'in' && origLot === null) { const v = parseNum(vol); if (v !== null) origLot = v; }
    if (direction !== 'out') continue;
    const p = parseNum(profit), c = parseNum(comm) || 0, s = parseNum(swap) || 0;
    if (p === null) continue;
    const t = parseDateMT5(timeS);
    if (t === null) continue;
    closed.push([t, Math.round((p+c+s)*100)/100]);
  }
  if (!closed.length) throw new Error('อ่านไฟล์ได้ แต่ไม่พบไม้ที่ปิด (closed trade) เลย');
  closed.sort((a,b)=>a[0]-b[0]);
  return { t: closed.map(c=>c[0]), p: closed.map(c=>c[1]), orig_lot: origLot || 0.1, orig_deposit: origDeposit || 1000, n: closed.length };
}
async function parseXlsxReport(file){
  if (typeof XLSX === 'undefined') throw new Error('โหลดไลบรารีอ่านไฟล์ Excel ไม่สำเร็จ (ต้องต่ออินเทอร์เน็ตครั้งแรก) ลองใช้ไฟล์ .html แทน');
  const buf = await file.arrayBuffer();
  const wb = XLSX.read(buf, {type:'array', cellDates:true});
  const ws = wb.Sheets[wb.SheetNames[0]];
  const rows = XLSX.utils.sheet_to_json(ws, {header:1, raw:true, defval:null});
  let inDeals=false, headerSeen=false, origLot=null, origDeposit=null;
  const closed = [];
  for (const row of rows){
    const first = row[0];
    if (first === 'Deals'){ inDeals = true; continue; }
    if (!inDeals) continue;
    if (first === 'Time'){ headerSeen = true; continue; }
    if (!headerSeen) continue;
    if (first === null || first === undefined || first === '') continue;
    const typ = row[3], direction = row[4], vol = row[5], comm = row[8], swap = row[9], profit = row[10];
    if (typ === 'balance' && origDeposit === null){ const dep = parseNum(profit); if (dep !== null) origDeposit = dep; continue; }
    if (direction !== 'in' && direction !== 'out') continue;
    if (direction === 'in' && origLot === null){ const v = parseNum(vol); if (v !== null) origLot = v; }
    if (direction !== 'out') continue;
    const p = parseNum(profit), c = parseNum(comm) || 0, s = parseNum(swap) || 0;
    if (p === null) continue;
    let t;
    if (first instanceof Date) t = Date.UTC(first.getFullYear(), first.getMonth(), first.getDate(), first.getHours(), first.getMinutes(), first.getSeconds());
    else t = parseDateMT5(String(first));
    if (!t) continue;
    closed.push([t, Math.round((p+c+s)*100)/100]);
  }
  if (!closed.length) throw new Error('อ่านไฟล์ Excel ได้ แต่ไม่พบไม้ที่ปิด (closed trade) เลย');
  closed.sort((a,b)=>a[0]-b[0]);
  return { t: closed.map(c=>c[0]), p: closed.map(c=>c[1]), orig_lot: origLot || 0.1, orig_deposit: origDeposit || 1000, n: closed.length };
}
