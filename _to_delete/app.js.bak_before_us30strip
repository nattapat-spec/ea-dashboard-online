 double    InpADXThreshold         = 25.0;\ninput double    InpDIGap                = 5.0;\n\n//====================================================================\n//  [S1] [S2] [OVL] เปิด/ปิดระบบย่อย + อนุญาตเปิดซ้อนกันหรือไม่\n//====================================================================\ninput bool      InpEnableS1             = true;   // [S1] เปิดระบบ 1 (เศษราคา)\ninput bool      InpEnableS2             = true;   // [S2] เปิดระบบ 2 (RSI+EMA)\ninput bool      InpAllowOverlap         = true;    // [OVL] true = S1/S2 เปิดพร้อมกันได้ / false = ห้ามซ้อน\n\n//====================================================================\n//  [DI12] DI Gap ≥12 — ที่มา: US30_v1.81_RSI5545_DI12\n//====================================================================\ninput bool      InpUseDI12Threshold     = false;   // [DI12] true = ใช้ DI Gap=12 แทน InpDIGap ด้านบน\n\n//====================================================================\n//  [ADXR] ADX Rising (เทียบ 2 ชม.ย้อนหลัง แก้บั๊กแล้ว) — ที่มา: US30_v1.81_RSI5545_ADXRising2H\n//====================================================================\ninput bool      InpUseADXRising         = false;   // [ADXR] เปิด ADX Rising Filter\ninput int       InpADXRisingBars        = 4;       // เทียบ ADX ตอนนี้ กับ N แท่งก่อนหน้า (4 แท่ง M30 = 2ชม.)\n\n//====================================================================\n//  [SESS] Session Filter — ที่มา: US30_v1.81_RSI5545_Session\n//====================================================================\ninput bool      InpUseSessionFilter     = false;   // [SESS] เปิด Session Filter\ninput int       InpSessionStart         = 10;      // เริ่มเทรด XX:00 (Server Time)\ninput int       InpSessionEnd           = 23;      // หยุดเทรด XX:00 (Server Time)\n\n//====================================================================\n//  [H4] H4 Trend Filter — ที่มา: US30_v2.02_TS200_ManualSL_H4Filter\n//====================================================================\ninput bool      InpUseH4Filter          = false;   // [H4] เปิด H4 Trend Filter\ninput int       InpH4EMAPeriod          = 40;\n\n//====================================================================\n//  [NEWS] News Time Block — ที่มา: US30_v2.03_TS200_ManualSL_NewsBlock\n//====================================================================\ninput bool      InpNewsBlockEnabled     = false;   // [NEWS] เปิด News Time Block\ninput int       InpNewsBufferMins       = 30;\ninput bool      InpBlock1230            = true;    // NFP/CPI/PPI (UTC)\ninput bool      InpBlock1400            = true;    // ISM/Conf (UTC)\ninput bool      InpBlock1800            = true;    // FOMC (UTC)\ninput bool      InpBlock1830            = true;    // Fed Press Conf (UTC)\ninput string    InpCustomTimes          = \"\";      // เพิ่มเอง เช่น \"08:30,20:00\" (UTC HH:MM)\n\n//====================================================================\n//  [RSIC] RSI Buy Ceiling — มีอยู่แล้วใน v2.10.6c\n//====================================================================\ninput bool      InpUseRSICeiling        = false;   // [RSIC] เปิดเพดาน RSI กัน overbought ฝั่ง BUY\ninput double    InpRSIBuyCeiling        = 70.0;    // ใช้เมื่อ InpUseRSICeiling = true เท่านั้น\n\n//====================================================================\n//  [GATE] Vol/Spread Gate — ที่มา: US30_v2.10.6c (มี 2 สวิตช์ย่อย)\n//====================================================================\ninput bool      InpVolGateEnabled       = false;   // [GATE] Volatility Gate (ATR)\ninput int       InpVolGateAvgBars       = 20;\ninput double    InpVolGateMultiplier    = 1.8;\ninput bool      InpSpreadGateEnabled    = false;   // [GATE] Spread Gate\ninput int       InpSpreadGateAvgBars    = 20;\ninput double    InpSpreadGateMultiplier = 2.0;\ninput double    InpSpreadGateMaxPts     = 150.0;\n\n//====================================================================\n//  [ATR] ATR-based SL (System 2) — ที่มา: US30_v2.10.6c\n//====================================================================\ninput bool      InpUseATRSL             = false;   // [ATR]\ninput double    InpATRMultiplier        = 1.0;\ninput double    InpATRMinPts            = 80.0;\ninput double    InpATRMaxPts            = 250.0;\ninput double    InpSys2SLPoints         = 150.0;   // ใช้เมื่อ InpUseATRSL = false\n\n//====================================================================\n//  [RLOT] Risk-based Lot — ที่มา: US30_v1.96_TS200_ManualSL_RiskBoth\n//====================================================================\ninput bool      InpUseRiskLot           = false;   // [RLOT] true = คำนวณ Lot จาก Risk USD แทน Fixed Lot\ninput double    InpRiskUSD              = 20.0;    // เสียสูงสุดต่อ trade (USD) — ใช้เมื่อ InpUseRiskLot = true\n\n//====================================================================\n//  [DLL] Daily Loss Limit — ที่มา: US30_v2.10.6c\n//====================================================================\ninput bool      InpUseDailyLossLimit    = true;    // [DLL]\ninput double    InpMaxDailyLossUSD      = 60.0;\n\n//====================================================================\n//  [CLC] Consecutive Loss Cooldown — ที่มา: US30_v1.99_TS200_ManualSL_ConsecLoss\n//====================================================================\ninput bool      InpUseCooldown          = false;   // [CLC]\ninput int       InpCooldownThreshold    = 2;       // หยุดเมื่อแพ้/BE ติดกัน >= X ครั้ง\ninput double    InpBEThreshold          = 5.0;     // กำไร < X USD = นับเป็น loss (BE ~$0-2)\ninput bool      InpCooldownAlert        = true;\n\n//====================================================================\n//  [TS] Trailing Stop — ที่มา: US30_v2.10.6c\n//====================================================================\ninput bool      InpUseTrailing          = true;    // [TS]\ninput double    InpTrailActivate        = 200.0;\ninput double    InpTrailPoints          = 180.0;\n\n//====================================================================\n//  [BE] Breakeven (Unified EA+Manual) — ที่มา: US30_v2.10.6c\n//====================================================================\ninput bool      InpEABE                 = true;    // [BE]\ninput double    InpEABEBuffer           = 30.0;\n\n//====================================================================\n//  [MANU] Manual Trade Management — ที่มา: US30_v2.10.6c\n//====================================================================\ninput bool      InpManageManual         = true;    // [MANU] จัดการไม้ที่เปิดด้วยมือ (magic=0) ด้วย BE/Trailing เดียวกัน\n\n//====================================================================\n//  [PC] Partial Close — ที่มา: US30_v2.00_TS200_ManualSL_PartialClose\n//====================================================================\ninput bool      InpPartialClose         = false;   // [PC]\ninput double    InpPartialRR            = 1.0;     // ปิด partial เมื่อกำไร >= X × SL distance\ninput double    InpPartialPct           = 50.0;    // ปิดกี่ % ของ position\n\n//====================================================================\n//  [TSTOP] System 2 Time-Based Exit (\"Slow Bleed\" cutoff) — ที่มา: US30_v2.10.6c\n//====================================================================\ninput bool      InpS2TimeStopEnabled    = false;   // [TSTOP]\ninput double    InpS2TimeStopHours      = 7.0;\ninput double    InpS2TimeStopMinRR      = 0.3;\ninput ENUM_S2_TIMESTOP_ACTION InpS2TimeStopAction = S2_TIMESTOP_TIGHTEN;\ninput double    InpS2TimeStopTightenPts = 50.0;\n\n//====================================================================\n//  [TPX] TP Extension 3.5R — ⚠️ ไม่พบไฟล์ต้นแบบที่ implement จริง\n//  ไม่ได้ต่อโค้ดให้ (ทิ้ง input ไว้เฉยๆ กันสับสนว่า \"มี\" ทั้งที่ยังไม่ทำงาน)\n//  ถ้าต้องการฟีเจอร์นี้จริง ให้ระบุกติกาที่ต้องการ (ขยาย TP ยังไง เงื่อนไขอะไร)\n//  แล้วเขียน/ทดสอบแยกเป็นเคสเฉพาะ อย่าเปิดใช้บนไฟล์นี้โดยไม่มี logic จริง\n//====================================================================\n// input bool   InpTPExtension_NOT_IMPLEMENTED = false;  // ทิ้งไว้เป็นคอมเมนต์เจตนา ไม่ประกาศเป็น input จริง กันสับสน\n\n//====================================================================\n//  [WED] S2 เทรดวันพุธได้ — ที่มา: US30_v2.10.5_TS200_UnifiedBE_ATR_NoNews_S2NoWedBlock\n//  (S1 หยุดวันพุธเสมอ ไม่มี toggle — ตามต้นแบบเดิมทุกเวอร์ชัน)\n//====================================================================\ninput bool      InpS2AllowTradeWednesday = false;  // [WED] true = S2 เปิดไม้วันพุธได้ (S1 หยุดเหมือนเดิมเสมอ)\n\n//====================================================================\n//  [ALTF] Timeframe อื่น (M15/H1) — ที่มา: US30_v2.01_M15_TS200_ATR_SL\n//====================================================================\ninput ENUM_TIMEFRAMES InpTimeframe      = PERIOD_M30;  // [ALTF] เปลี่ยนเป็น PERIOD_M15 / PERIOD_H1 ได้\n\n//====================================================================\n//  [SMA] ใช้ SMA แทน EMA — ที่มา: US30_v2.10.2_TS200_UnifiedBE_ATR_NoNews_SMA\n//====================================================================\ninput bool      InpUseSMA               = false;   // [SMA] true = SMA(40) / false = EMA(40)\n\n//====================================================================\n//  Telegram (ใส่ของตัวเองหรือปล่อยว่างเพื่อปิดการแจ้งเตือน)\n//====================================================================\ninput string    InpTeleToken            = \"\";\ninput string    InpTeleChatID           = \"\";\n\nCTrade  trade;\nint     handleMA, handleADX, handleRSI, handleATR, handleH4MA;\ndouble  g_spreadHist[];\nint     g_spreadHistCount = 0;\n\n//+------------------------------------------------------------------+\n//|  Telegram helper — วางไว้บนสุด เพราะฟังก์ชันอื่นๆ ด้านล่างเรียกใช้    |\n//+------------------------------------------------------------------+\nstring UrlEncode(string str) {\n   string out = \"\"; uchar array[];\n   StringToCharArray(str, array, 0, WHOLE_ARRAY, CP_UTF8);\n   for(int i = 0; i < ArraySize(array)-1; i++) {\n      uchar c = array[i];\n      if((c>=48&&c<=57)||(c>=65&&c<=90)||(c>=97&&c<=122)) out += ShortToString(c);\n      else out += StringFormat(\"%%%02X\", c);\n   }\n   return out;\n}\n\nvoid SendTelegram(string msg) {\n   if(InpTeleToken == \"\" || InpTeleChatID == \"\") return;\n   string url = \"https://api.telegram.org/bot\" + InpTeleToken + \"/sendMessage?chat_id=\" + InpTeleChatID + \"&text=\" + UrlEncode(msg);\n   char post[], result[]; string headers;\n   ResetLastError();\n   WebRequest(\"GET\", url, NULL, NULL, 5000, post, 0, result, headers);\n}\n\n//+------------------------------------------------------------------+\n//|  [ATR] ATR-based SL                                               |\n//+------------------------------------------------------------------+\ndouble GetS2SLPoints() {\n   if(!InpUseATRSL) return InpSys2SLPoints;\n   double atrBuf[];\n   ArraySetAsSeries(atrBuf, true);\n   if(CopyBuffer(handleATR, 0, 0, 3, atrBuf) < 3) return InpSys2SLPoints;\n   double atrPts = atrBuf[1] / _Point;\n   double slPts  = atrPts * InpATRMultiplier;\n   slPts = MathMax(InpATRMinPts, MathMin(InpATRMaxPts, slPts));\n   return slPts;\n}\n\n//+------------------------------------------------------------------+\n//|  [RLOT] Risk-based Lot — คำนวณ Lot จาก Risk USD และระยะ SL (points)|\n//+------------------------------------------------------------------+\ndouble CalcLot(double slPoints) {\n   if(!InpUseRiskLot || InpRiskUSD <= 0 || slPoints <= 0) return InpFixedLot;\n   double tickSize  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);\n   double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);\n   if(tickSize <= 0 || tickValue <= 0) return InpFixedLot;\n   double dollarPerPoint = tickValue / tickSize;\n   if(dollarPerPoint <= 0) return InpFixedLot;\n   double lot = InpRiskUSD / (slPoints * dollarPerPoint);\n   double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);\n   double maxLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);\n   double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);\n   if(lotStep > 0) lot = MathFloor(lot / lotStep) * lotStep;\n   lot = MathMax(minLot, MathMin(maxLot, lot));\n   return NormalizeDouble(lot, 2);\n}\n\n//+------------------------------------------------------------------+\n//|  [DI12] Effective DI Gap threshold                                |\n//+------------------------------------------------------------------+\ndouble EffectiveDIGap() {\n   return InpUseDI12Threshold ? 12.0 : InpDIGap;\n}\n\n//+------------------------------------------------------------------+\n//|  [H4] H4 Trend Filter — 1=uptrend, -1=downtrend, 0=off/N-A         |\n//+------------------------------------------------------------------+\nint GetH4Trend() {\n   if(!InpUseH4Filter) return 0;\n   double h4ema[]; ArraySetAsSeries(h4ema, true);\n   if(CopyBuffer(handleH4MA, 0, 0, 5, h4ema) < 5) return 0;\n   if(h4ema[1] > h4ema[4]) return 1;\n   if(h4ema[1] < h4ema[4]) return -1;\n   return 0;\n}\n\n//+------------------------------------------------------------------+\n//|  [NEWS] News Time Block                                           |\n//+------------------------------------------------------------------+\nbool IsNewsTime() {\n   if(!InpNewsBlockEnabled) return false;\n   MqlDateTime dt;\n   TimeToStruct(TimeCurrent(), dt);\n   int nowMins = dt.hour * 60 + dt.min;\n\n   int newsTimes[4];\n   int newsCount = 0;\n   if(InpBlock1230) newsTimes[newsCount++] = 12*60 + 30;\n   if(InpBlock1400) newsTimes[newsCount++] = 14*60 + 0;\n   if(InpBlock1800) newsTimes[newsCount++] = 18*60 + 0;\n   if(InpBlock1830) newsTimes[newsCount++] = 18*60 + 30;\n\n   for(int i = 0; i < newsCount; i++) {\n      int diff = MathAbs(nowMins - newsTimes[i]);\n      if(diff > 720) diff = 1440 - diff;\n      if(diff <= InpNewsBufferMins) return true;\n   }\n\n   if(StringLen(InpCustomTimes) > 0) {\n      string parts[];\n      int n = StringSplit(InpCustomTimes, ',', parts);\n      for(int i = 0; i < n; i++) {\n         string t = parts[i];\n         StringTrimLeft(t); StringTrimRight(t);\n         string hm[];\n         if(StringSplit(t, ':', hm) == 2) {\n            int h = (int)StringToInteger(hm[0]);\n            int m = (int)StringToInteger(hm[1]);\n            int newsMin = h*60 + m;\n            int diff = MathAbs(nowMins - newsMin);\n            if(diff > 720) diff = 1440 - diff;\n            if(diff <= InpNewsBufferMins) return true;\n         }\n      }\n   }\n   return false;\n}\n\n//+------------------------------------------------------------------+\n//|  [CLC] Consecutive Loss Cooldown                                  |\n//+------------------------------------------------------------------+\nint GetTodayConsecLosses() {\n   datetime startOfDay = StringToTime(TimeToString(TimeCurrent(), TIME_DATE));\n   if(!HistorySelect(startOfDay, TimeCurrent() + 5)) return 0;\n   uint total = HistoryDealsTotal();\n   int streak = 0;\n   for(int i = (int)total - 1; i >= 0; i--) {\n      ulong ticket = HistoryDealGetTicket(i);\n      if(HistoryDealGetInteger(ticket, DEAL_MAGIC) != InpMagicNumber) continue;\n      if(HistoryDealGetInteger(ticket, DEAL_ENTRY) != DEAL_ENTRY_OUT) continue;\n      double net = HistoryDealGetDouble(ticket, DEAL_PROFIT)\n                 + HistoryDealGetDouble(ticket, DEAL_COMMISSION)\n                 + HistoryDealGetDouble(ticket, DEAL_SWAP);\n      if(net < InpBEThreshold) streak++;\n      else break;\n   }\n   return streak;\n}\n\nbool IsCooldown() {\n   if(!InpUseCooldown || InpCooldownThreshold <= 0) return false;\n   int streak = GetTodayConsecLosses();\n   if(streak >= InpCooldownThreshold) {\n      static datetime lastCooldownAlert = 0;\n      datetime currentBar = iTime(_Symbol, InpTimeframe, 0);\n      if(InpCooldownAlert && currentBar != lastCooldownAlert) {\n         SendTelegram(\"🧊 Cooldown! แพ้/BE \" + IntegerToString(streak)\n                    + \" ไม้ติด ≥ \" + IntegerToString(InpCooldownThreshold)\n                    + \" หยุดวันนี้ฮับคุณมู\");\n         lastCooldownAlert = currentBar;\n      }\n      return true;\n   }\n   return false;\n}\n\n//+------------------------------------------------------------------+\n//|  [GATE] Volatility Gate                                           |\n//+------------------------------------------------------------------+\nbool IsVolatilityOK(double &currentATRPts, double &avgATRPts) {\n   currentATRPts = 0; avgATRPts = 0;\n   if(!InpVolGateEnabled) return true;\n   int need = InpVolGateAvgBars + 2;\n   double atrBuf[];\n   ArraySetAsSeries(atrBuf, true);\n   if(CopyBuffer(handleATR, 0, 0, need, atrBuf) < need) return true;\n   currentATRPts = atrBuf[1] / _Point;\n   double sum = 0;\n   for(int i = 2; i < 2 + InpVolGateAvgBars; i++) sum += atrBuf[i];\n   avgATRPts = (sum / InpVolGateAvgBars) / _Point;\n   if(avgATRPts <= 0) return true;\n   return (currentATRPts <= avgATRPts * InpVolGateMultiplier);\n}\n\n//+------------------------------------------------------------------+\n//|  [GATE] Spread Gate                                               |\n//+------------------------------------------------------------------+\nbool IsSpreadOK(double &currentSpreadPts, double &avgSpreadPts) {\n   currentSpreadPts = (double)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);\n   avgSpreadPts = 0;\n   int N = InpSpreadGateAvgBars;\n   if(ArraySize(g_spreadHist) != N) ArrayResize(g_spreadHist, N);\n   g_spreadHist[g_spreadHistCount % N] = currentSpreadPts;\n   g_spreadHistCount++;\n   if(!InpSpreadGateEnabled) return true;\n   if(currentSpreadPts > InpSpreadGateMaxPts) return false;\n   int cnt = MathMin(g_spreadHistCount, N);\n   if(cnt < N) return true;\n   double sum = 0;\n   for(int i = 0; i < N; i++) sum += g_spreadHist[i];\n   avgSpreadPts = sum / N;\n   if(avgSpreadPts <= 0) return true;\n   return (currentSpreadPts <= avgSpreadPts * InpSpreadGateMultiplier);\n}\n\ndouble GetTodayPnL() {\n   double totalPnL = 0;\n   datetime startOfDay = StringToTime(TimeToString(TimeCurrent(), TIME_DATE));\n   if(!HistorySelect(startOfDay, TimeCurrent() + 5)) return 0;\n   uint total = HistoryDealsTotal();\n   for(uint i = 0; i < total; i++) {\n      ulong ticket = HistoryDealGetTicket(i);\n      if(HistoryDealGetInteger(ticket, DEAL_MAGIC) != InpMagicNumber) continue;\n      if(HistoryDealGetInteger(ticket, DEAL_ENTRY) != DEAL_ENTRY_OUT) continue;\n      totalPnL += HistoryDealGetDouble(ticket, DEAL_PROFIT)\n               +  HistoryDealGetDouble(ticket, DEAL_COMMISSION)\n               +  HistoryDealGetDouble(ticket, DEAL_SWAP);\n   }\n   return totalPnL;\n}\n\nvoid CheckOrderClosedAlert() {\n   static datetime lastCheck = 0;\n   if(lastCheck == 0) lastCheck = TimeCurrent();\n   if(!HistorySelect(lastCheck, TimeCurrent() + 5)) return;\n   uint total = HistoryDealsTotal();\n   for(uint i = 0; i < total; i++) {\n      ulong ticket = HistoryDealGetTicket(i);\n      if(HistoryDealGetInteger(ticket, DEAL_MAGIC) != InpMagicNumber) continue;\n      if(HistoryDealGetInteger(ticket, DEAL_ENTRY) != DEAL_ENTRY_OUT) continue;\n      double net = HistoryDealGetDouble(ticket, DEAL_PROFIT)\n                 + HistoryDealGetDouble(ticket, DEAL_COMMISSION)\n                 + HistoryDealGetDouble(ticket, DEAL_SWAP);\n      if(net >= 0) SendTelegram(\"✅ TP/Trail กำไร $\" + DoubleToString(net, 2) + \" รวย รวย รวย ฮับคุณมู\");\n      else         SendTelegram(\"❌ SL ขาดทุน $\" + DoubleToString(MathAbs(net), 2) + \" คราวหน้าสู้ใหม่ฮับ\");\n   }\n   lastCheck = TimeCurrent();\n}\n\n//+------------------------------------------------------------------+\n//|  ApplyTrailAndBE — ลำดับ: [PC] Partial Close → [BE] → [TS] Trail   |\n//+------------------------------------------------------------------+\nvoid ApplyTrailAndBE(ulong ticket, bool isManual) {\n   if(!PositionSelectByTicket(ticket)) return;\n   if(PositionGetString(POSITION_SYMBOL) != _Symbol) return;\n   double entry  = PositionGetDouble(POSITION_PRICE_OPEN);\n   double sl     = PositionGetDouble(POSITION_SL);\n   double price  = PositionGetDouble(POSITION_PRICE_CURRENT);\n   double tp     = PositionGetDouble(POSITION_TP);\n   double lot    = PositionGetDouble(POSITION_VOLUME);\n   ENUM_POSITION_TYPE posType = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);\n   string tag    = isManual ? \"[มือ]\" : \"[EA]\";\n   double slDist = (sl > 0) ? MathAbs(entry - sl) : 0;\n\n   if(posType == POSITION_TYPE_BUY) {\n      double profit = price - entry;\n\n      // [PC] Partial Close ที่ InpPartialRR × SL distance (เฉพาะไม้ EA ไม่ใช่ manual)\n      if(InpPartialClose && !isManual && slDist > 0 && profit >= slDist * InpPartialRR && sl < entry) {\n         double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);\n         double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);\n         double closeLot = NormalizeDouble(lot * InpPartialPct / 100.0, 2);\n         closeLot = MathMax(minLot, MathFloor(closeLot / lotStep) * lotStep);\n         if(closeLot < lot && closeLot > 0) {\n            if(trade.PositionClosePartial(ticket, closeLot)) {\n               double beSL = NormalizeDouble(entry + 1.0, _Digits);\n               trade.PositionModify(ticket, beSL, tp);\n               SendTelegram(\"✂️ \" + tag + \" Partial \" + DoubleToString(InpPartialPct, 0) + \"% ปิด \"\n                          + DoubleToString(closeLot, 2) + \" lots ที่ +\" + DoubleToString(InpPartialRR,1) + \"R | SL → BE\");\n               return;\n            }\n         }\n      }\n\n      // [BE] Unified BE — 1:1 R:R\n      if(InpEABE && sl > 0 && sl < entry) {\n         double risk = entry - sl;\n         double beSL = NormalizeDouble(entry + InpEABEBuffer, _Digits);\n         if(profit >= risk && sl < beSL) {\n            if(trade.PositionModify(ticket, beSL, tp))\n               SendTelegram(\"🔒 \" + tag + \" BE 1:1 → SL=\" + DoubleToString(beSL, _Digits));\n            return;\n         }\n      }\n\n      // [TS] Trail\n      if(InpUseTrailing && profit >= InpTrailActivate) {\n         double newSL = NormalizeDouble(price - InpTrailPoints, _Digits);\n         if(newSL > sl) {\n            if(trade.PositionModify(ticket, newSL, tp))\n               SendTelegram(\"🔄 \" + tag + \" Trail↑ SL → \" + DoubleToString(newSL, _Digits));\n         }\n      }\n\n   } else { // SELL\n      double profit = entry - price;\n\n      if(InpPartialClose && !isManual && slDist > 0 && profit >= slDist * InpPartialRR && (sl == 0 || sl > entry)) {\n         double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);\n         double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);\n         double closeLot = NormalizeDouble(lot * InpPartialPct / 100.0, 2);\n         closeLot = MathMax(minLot, MathFloor(closeLot / lotStep) * lotStep);\n         if(closeLot < lot && closeLot > 0) {\n            if(trade.PositionClosePartial(ticket, closeLot)) {\n               double beSL = NormalizeDouble(entry - 1.0, _Digits);\n               trade.PositionModify(ticket, beSL, tp);\n               SendTelegram(\"✂️ \" + tag + \" Partial \" + DoubleToString(InpPartialPct, 0) + \"% ปิด \"\n                          + DoubleToString(closeLot, 2) + \" lots ที่ +\" + DoubleToString(InpPartialRR,1) + \"R | SL → BE\");\n               return;\n            }\n         }\n      }\n\n      if(InpEABE && sl > 0 && sl > entry) {\n         double risk = sl - entry;\n         double beSL = NormalizeDouble(entry - InpEABEBuffer, _Digits);\n         if(profit >= risk && sl > beSL) {\n            if(trade.PositionModify(ticket, beSL, tp))\n               SendTelegram(\"🔒 \" + tag + \" BE 1:1 → SL=\" + DoubleToString(beSL, _Digits));\n            return;\n         }\n      }\n\n      if(InpUseTrailing && profit >= InpTrailActivate) {\n         double newSL = NormalizeDouble(price + InpTrailPoints, _Digits);\n         if(sl == 0 || newSL < sl) {\n            if(trade.PositionModify(ticket, newSL, tp))\n               SendTelegram(\"🔄 \" + tag + \" Trail↓ SL → \" + DoubleToString(newSL, _Digits));\n         }\n      }\n   }\n}\n\n//+------------------------------------------------------------------+\n//|  [TSTOP] ApplyS2TimeStop — เฉพาะไม้ System 2                       |\n//+------------------------------------------------------------------+\nvoid ApplyS2TimeStop(ulong ticket) {\n   if(!InpS2TimeStopEnabled) return;\n   if(!PositionSelectByTicket(ticket)) return;\n   if(PositionGetString(POSITION_SYMBOL) != _Symbol) return;\n   if(StringFind(PositionGetString(POSITION_COMMENT), \"-S2\") < 0) return;\n\n   double entry = PositionGetDouble(POSITION_PRICE_OPEN);\n   double sl    = PositionGetDouble(POSITION_SL);\n   if(sl <= 0) return;\n\n   double price = PositionGetDouble(POSITION_PRICE_CURRENT);\n   ENUM_POSITION_TYPE posType = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);\n   datetime openTime = (datetime)PositionGetInteger(POSITION_TIME);\n   double holdHours = (double)(TimeCurrent() - openTime) / 3600.0;\n   if(holdHours < InpS2TimeStopHours) return;\n\n   double profitPts, riskPts;\n   bool stillAtRisk;\n   if(posType == POSITION_TYPE_BUY) {\n      profitPts   = (price - entry) / _Point;\n      riskPts     = (entry - sl)    / _Point;\n      stillAtRisk = (sl < entry);\n   } else {\n      profitPts   = (entry - price) / _Point;\n      riskPts     = (sl - entry)    / _Point;\n      stillAtRisk = (sl > entry);\n   }\n   if(!stillAtRisk) return;\n   if(riskPts <= 0) return;\n\n   bool notNearTarget = (profitPts < riskPts * InpS2TimeStopMinRR);\n   if(!notNearTarget) return;\n\n   if(InpS2TimeStopAction == S2_TIMESTOP_CLOSE) {\n      double floatingProfit = PositionGetDouble(POSITION_PROFIT);\n      if(trade.PositionClose(ticket))\n         SendTelegram(\"⏱️ [S2] Time-Stop ปิดไม้ (ถือ \" + DoubleToString(holdHours,1) + \"ชม.) กำไรตอนปิด $\" + DoubleToString(floatingProfit,2));\n   } else {\n      double newSL;\n      if(posType == POSITION_TYPE_BUY) {\n         newSL = NormalizeDouble(entry - InpS2TimeStopTightenPts*_Point, _Digits);\n         if(newSL <= sl) return;\n      } else {\n         newSL = NormalizeDouble(entry + InpS2TimeStopTightenPts*_Point, _Digits);\n         if(newSL >= sl) return;\n      }\n      if(trade.PositionModify(ticket, newSL, PositionGetDouble(POSITION_TP)))\n         SendTelegram(\"⏱️ [S2] Time-Stop แคบ SL → \" + DoubleToString(newSL,_Digits));\n   }\n}\n\nvoid ManagePositions() {\n   for(int i = PositionsTotal()-1; i >= 0; i--) {\n      ulong ticket = PositionGetTicket(i);\n      if(!PositionSelectByTicket(ticket)) continue;\n      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;\n      long magic = PositionGetInteger(POSITION_MAGIC);\n      if(magic == InpMagicNumber) {\n         ApplyTrailAndBE(ticket, false);\n         ApplyS2TimeStop(ticket);\n      }\n      else if(InpManageManual && magic == 0) ApplyTrailAndBE(ticket, true);\n   }\n}\n\nbool HasOpenPosition(string systemTag) {\n   for(int i = 0; i < PositionsTotal(); i++) {\n      ulong ticket = PositionGetTicket(i);\n      if(!PositionSelectByTicket(ticket)) continue;\n      if(PositionGetInteger(POSITION_MAGIC) != InpMagicNumber) continue;\n      if(StringFind(PositionGetString(POSITION_COMMENT), systemTag) >= 0) return true;\n   }\n   return false;\n}\n\n//--- [OVL] เช็คว่ามีไม้ระบบอื่นเปิดอยู่หรือไม่ (ใช้ตอน InpAllowOverlap=false)\nbool HasAnyOpenPosition() {\n   for(int i = 0; i < PositionsTotal(); i++) {\n      ulong ticket = PositionGetTicket(i);\n      if(!PositionSelectByTicket(ticket)) continue;\n      if(PositionGetInteger(POSITION_MAGIC) == InpMagicNumber) return true;\n   }\n   return false;\n}\n\nint OnInit() {\n   trade.SetExpertMagicNumber(InpMagicNumber);\n   ENUM_MA_METHOD maMethod = InpUseSMA ? MODE_SMA : MODE_EMA;   // [SMA]\n   handleMA  = iMA (_Symbol, InpTimeframe, InpEMAPeriod, 0, maMethod, PRICE_CLOSE);  // [ALTF]\n   handleADX = iADX(_Symbol, InpTimeframe, InpADXPeriod);\n   handleRSI = iRSI(_Symbol, InpTimeframe, InpRSIPeriod, PRICE_