function renderEqChart(curve, capital, maxDDPoint){
  const svg = document.getElementById('eqChart');
  const W = Math.max(svg.parentElement.clientWidth, 600);
  const H = 220;
  const padL = 70, padR = 20, padT = 20, padB = 30;
  svg.setAttribute('width', W); svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
  const vals = curve.map(c=>c.v);
  const minV = Math.min(...vals, capital), maxV = Math.max(...vals, capital);
  const range = (maxV-minV)||1;
  const xScale = i => padL + (i/(curve.length-1)) * (W-padL-padR);
  const yScale = v => (H-padB) - ((v-minV)/range) * (H-padT-padB);
  let path = '';
  curve.forEach((c,i)=>{ const x=xScale(i), y=yScale(c.v); path += (i===0?'M':'L') + x.toFixed(1) + ',' + y.toFixed(1) + ' '; });
  const zeroY = yScale(0), capY = yScale(capital);
  const lastV = curve[curve.length-1].v;
  const lineColor = lastV >= capital ? 'var(--green)' : 'var(--red)';
  let s = '';
  for(let i=0;i<=4;i++){
    const gy = padT + (H-padT-padB)*i/4;
    const val = maxV - (range*i/4);
    s += `<line x1="${padL}" y1="${gy}" x2="${W-padR}" y2="${gy}" stroke="#232c44" stroke-width="1"/>`;
    s += `<text x="${padL-8}" y="${gy+4}" text-anchor="end" font-size="10" fill="#8b95ad">$${Math.round(val).toLocaleString()}</text>`;
  }
  if (capY>=padT && capY<=H-padB) s += `<line x1="${padL}" y1="${capY}" x2="${W-padR}" y2="${capY}" stroke="#f2b84b" stroke-width="1" stroke-dasharray="4,3"/>`;
  if (minV<0 && zeroY>=padT && zeroY<=H-padB) s += `<line x1="${padL}" y1="${zeroY}" x2="${W-padR}" y2="${zeroY}" stroke="var(--red)" stroke-width="1.5"/>`;
  s += `<path d="${path}" fill="none" stroke="${lineColor}" stroke-width="1.8"/>`;
  let ddIdx = -1;
  if (maxDDPoint){
    ddIdx = curve.findIndex(c=>c.t===maxDDPoint.t && c.v===maxDDPoint.v);
    if (ddIdx>=0){
      const dx = xScale(ddIdx), dy = yScale(curve[ddIdx].v);
      const labelAbove = dy > padT + 16;
      const ly = labelAbove ? dy - 10 : dy + 18;
      s += `<line x1="${dx}" y1="${padT}" x2="${dx}" y2="${H-padB}" stroke="var(--red)" stroke-width="1" stroke-dasharray="3,3" opacity="0.45"/>`;
      s += `<circle cx="${dx}" cy="${dy}" r="4.5" fill="var(--red)" stroke="#fff" stroke-width="1.3"/>`;
      s += `<text x="${dx}" y="${ly}" text-anchor="middle" font-size="10" font-weight="700" fill="var(--red)">Max DD</text>`;
    }
  }
  svg.innerHTML = s;
  svg.onmousemove = (ev)=>{
    const rect = svg.getBoundingClientRect();
    const scaleX = W / rect.width;
    const mx = (ev.clientX - rect.left) * scaleX;
    let idx = Math.round(((mx - padL) / (W-padL-padR)) * (curve.length-1));
    idx = Math.max(0, Math.min(curve.length-1, idx));
    const pt = curve[idx];
    if (!pt) { hideChartTooltip(); return; }
    const html = `<div class="tt-date">${dayKey(pt.t)}</div><div class="tt-row"><span class="tt-dot" style="background:${lineColor}"></span>คงเหลือ: <b>${fmt(pt.v)}</b></div>`;
    showChartTooltip(ev.clientX, ev.clientY, html);
  };
  svg.onmouseleave = hideChartTooltip;
}
