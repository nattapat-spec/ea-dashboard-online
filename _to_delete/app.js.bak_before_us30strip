let cmpKpiSortKey = 'netProfit';
let cmpKpiSortDir = -1; /* -1 = มาก→น้อย (default), 1 = น้อย→มาก */
function cmpKpiSort(key){
  if (cmpKpiSortKey === key) cmpKpiSortDir *= -1;
  else { cmpKpiSortKey = key; cmpKpiSortDir = (key === 'short') ? 1 : -1; }
