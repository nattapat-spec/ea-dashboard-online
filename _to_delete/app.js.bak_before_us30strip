    return cmpKpiSortDir * (av - bv);
  });
  let h = '<thead><tr>' + CMP_KPI_COLS.map(c=>{
    const active = c.key === cmpKpiSortKey;
    const arrow = active ? (cmpKpiSortDir===1 ? ' ▲' : ' ▼') : '';
    return `<th class="sortable-th${active?' sorted':''}" onclick="cmpKpiSort('${c.key}')" title="กดเพื่อเรียงลำดับตามคอลัมน์นี้">${c.label}${arrow}</th>`;
  }).join('') + '</tr></thead><tbody>';
  const bestNet = Math.max(...sims.map(s=>s.netProfit));
  const worstNet = Math.min(...sims.map(s=>s.netProfit));
  rows.forEach(s=>{
    const npCls = s.netProfit>=0?'pos':'neg';
    const cellCls = s.netProfit===bestNet ? 'best-cell' : (s.netProfit===worstNet ? 'worst-cell' : '');
