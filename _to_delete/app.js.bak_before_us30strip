    const code = row.id;
    CUSTOM[code] = { name: row.name, short: label, orig_lot: parsed.orig_lot, orig_deposit: parsed.orig_deposit, t: parsed.t, p: parsed.p, n: parsed.n, sourceCode, mq5Name, flags };
