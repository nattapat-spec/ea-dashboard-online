    showStatus(`เพิ่ม "${label}" สำเร็จ — พบ ${parsed.n.toLocaleString()} ไม้ที่ปิด, Lot เดิม ${parsed.orig_lot}, ทุนเดิม $${parsed.orig_deposit.toLocaleString()}${extra} — บันทึกลง Supabase แล้ว ✓ (ทุกคนที่เข้าลิงก์นี้จะเห็นด้วย)`, true);
    fileInput.value = ''; labelInput.value = ''; eaFileInput.value = '';
    resetUploadFeatGrid();
    document.getElementById('uploadFeatPanel').classList.add('collapsed');
    document.getElementById('chev-uploadFeat').textContent = '▸';
  } catch(err){
    showStatus('เกิดข้อผิดพลาด: ' + err.message, false);
  }
}

/* ============ CREATE NEW EA (spec builder from a base template) ============ */
function showCreateStatus(msg, ok){
  const el = document.getElementById('createStatusMsg');
  if (!el) return;
  el.textContent = msg;
  el.className = 'status-msg ' + (ok ? 'ok' : 'err');
}
function populateCreateBaseSelect(){
  const el = document.getElementById('createBaseSelect');
  if (!el) return;
  const codes = allCodes();
  const top10 = codes.filter(c=>TOP10_ORDER.includes(c));
  const custom = codes.filter(c=>CUSTOM[c]);
  const rest = codes.filter(c=>!TOP10_ORDER.includes(c) && !CUSTOM[c]);
  const optLabel = c=>{ const d = getEA(c); return `${(d && (d.short || d.name)) || c}`; };
  let h = '<optgroup label="⚙️ Master Template (ออกไฟล์ .mq5 พร้อมใช้ได้จริง)"><option value="MASTER">' + MASTER_TEMPLATE.short + '</option></optgroup>';
  if (top10.length) h += '<optgroup label="Top 10">' + top10.map(c=>`<option value="${c}">${optLabel(c)}</option>`).join('') + '</optgroup>';
  if (rest.length) h += '<optgroup label="แคตตาล็อกอื่นๆ">' + rest.map(c=>`<option value="${c}">${optLabel(c)}</option>`).join('') + '</optgroup>';
  if (custom.length) h += '<optgroup label="อัพโหลดเอง">' + custom.map(c=>`<option value="${c}">${optLabel(c)}</option>`).join('') + '</optgroup>';
  el.innerHTML = h;
  onCreateBaseChange();
}
function buildCreateFeatGrid(baseFlags){
  const grid = document.getElementById('createFeatGrid');
  if (!grid) return;
  const cats = [];
  FEATURES.forEach(f=>{ if(!cats.includes(f.cat)) cats.push(f.cat); });
  let h = '';
  cats.forEach(cat=>{
    h += `<div class="feat-pick-cat">${cat}</div>`;
    FEATURES.filter(f=>f.cat===cat).forEach(f=>{
      const checked = (baseFlags && baseFlags[f.id]) ? 'checked' : '';
      h += `<label class="feat-pick"><input type="checkbox" id="createFeat_${f.id}" ${checked}> ${f.label}</label>`;
    });
  });
  grid.innerHTML = h;
}
function onCreateBaseChange(){
  const sel = document.getElementById('createBaseSelect');
  if (!sel) return;
  const baseFlags = (sel.value === 'MASTER') ? MASTER_TEMPLATE.flags : (getFlagsFor(sel.value) || {});
  buildCreateFeatGrid(baseFlags);
}
function readCreateFeatFlags(){
  const flags = {};
  FEATURES.forEach(f=>{
    const cb = document.getElementById('createFeat_'+f.id);
    flags[f.id] = (cb && cb.checked) ? 1 : 0;
  });
  return flags;
}
async function generateEASpec(){
  const sel = document.getElementById('createBaseSelect');
  const baseCode = sel ? sel.value : '';
  if (!baseCode){ showCreateStatus('กรุณาเลือก EA ต้นแบบก่อน', false); return; }
  const isMaster = (baseCode === 'MASTER');
  const baseFlags = isMaster ? MASTER_TEMPLATE.flags : (getFlagsFor(baseCode) || {});
  const newFlags = readCreateFeatFlags();
  const added = FEATURES.filter(f=> newFlags[f.id] && !baseFlags[f.id]);
  const removed = FEATURES.filter(f=> !newFlags[f.id] && baseFlags[f.id]);
  if (added.length === 0 && removed.length === 0){
    showCreateStatus('ยังไม่มีการเปลี่ยนแปลงคุณสมบัติจากต้นแบบ — ลองติ๊ก/ปลดติ๊กอย่างน้อย 1 อย่างก่อนสร้างใบสเปค', false);
    return;
  }
  const baseData = isMaster ? MASTER_TEMPLATE : getEA(baseCode);
  const baseLabel = isMaster ? MASTER_TEMPLATE.short : `${(baseData && (baseData.short || baseData.name)) || baseCode}`;
  const nameInput = document.getElementById('createNameInput');
  const name = (nameInput && nameInput.value.trim()) || (baseCode + '_Custom' + Date.now());
  const baseSourceCode = isMaster ? MASTER_TEMPLATE.sourceCode : ((CUSTOM[baseCode] && CUSTOM[baseCode].sourceCode) || null);
  const baseMq5Name = isMaster ? MASTER_TEMPLATE.mq5Name : ((CUSTOM[baseCode] && CUSTOM[baseCode].mq5Name) || null);
  showCreateStatus('กำลังบันทึกใบสเปค...', true);
  try{
    const row = await apiCreateDraft({
      base_code: baseCode,
      base_label: baseLabel,
      base_flags: Object.assign({}, baseFlags),
      new_flags: newFlags,
      added_ids: added.map(f=>f.id),
      removed_ids: removed.map(f=>f.id),
      base_source_code: baseSourceCode,
      base_mq5_name: baseMq5Name,
      name,
    });
    eaDrafts.push({
      id: row.id, name: row.name, baseCode: row.base_code, baseLabel: row.base_label,
      baseFlags: row.base_flags, newFlags: row.new_flags,
      addedIds: row.added_ids, removedIds: row.removed_ids,
      baseSourceCode: row.base_source_code, baseMq5Name: row.base_mq5_name,
      createdAt: row.created_at ? new Date(row.created_at).getTime() : Date.now(),
    });
    renderDraftsList();
    if (nameInput) nameInput.value = '';
    showCreateStatus(`สร้างใบสเปค "${name}" สำเร็จ — เพิ่ม ${added.length} คุณสมบัติ, ตัดออก ${removed.length} คุณสมบัติ จากต้นแบบ ${baseLabel} — บันทึกลง Supabase แล้ว`, true);
  } catch(e){
    showCreateStatus('สร้างใบสเปคไม่สำเร็จ: ' + e.message, false);
  }
}
function renderDraftsList(){
  const wrap = document.getElementById('createDraftList');
  const countEl = document.getElementById('createDraftCount');
  if (!wrap) return;
  if (countEl) countEl.textContent = eaDrafts.length ? `(${eaDrafts.length} รายการ)` : '';
  if (!eaDrafts.length){
    wrap.innerHTML = '<div class="empty-state" style="padding:14px 0;">ยังไม่มีใบสเปคที่สร้างไว้</div>';
    return;
  }
  wrap.innerHTML = eaDrafts.map(d=>`
    <div class="draft-card">
      <div class="draft-card-head"><b>${d.name}</b> <span class="tag">จาก ${d.baseLabel}</span></div>
      <div class="draft-diff"><span class="diff-added">+${d.addedIds.length} เพิ่ม</span><span class="diff-removed">−${d.removedIds.length} ตัด</span></div>
      <div class="draft-actions">
        <button class="code-btn" onclick="viewDraftSpec('${d.id}')">📄 ดูใบสเปค</button>
        <button class="code-btn" onclick="copyDraftSpec('${d.id}')">📋 คัดลอก</button>
        ${d.baseCode === 'MASTER' ? `<button class="code-btn" onclick="generateEACodeFile('${d.id}')" title="ดาวน์โหลด .mq5 พร้อมตั้งค่า input ตามใบสเปคนี้">⚙️ ดาวน์โหลด .mq5</button>` : ''}
        <button class="del-btn" onclick="deleteDraft('${d.id}')" title="ลบใบสเปคนี้">🗑</button>
      </div>
    </div>`).join('');
}
function buildSpecText(d){
  const lines = [];
  lines.push('=== ใบสเปค EA ใหม่: ' + d.name + ' ===');
  lines.push('ต้นแบบ: ' + d.baseLabel);
  lines.push('สร้างเมื่อ: ' + new Date(d.createdAt).toLocaleString('th-TH'));
  lines.push('');
  lines.push('คุณสมบัติที่เพิ่มจากต้นแบบ (' + d.addedIds.length + '):');
  lines.push(d.addedIds.length ? d.addedIds.map(id=>'  + ' + ((FEATURES.find(f=>f.id===id)||{}).label||id)).join('\n') : '  (ไม่มี)');
  lines.push('');
  lines.push('คุณสมบัติที่ตัดออกจากต้นแบบ (' + d.removedIds.length + '):');
  lines.push(d.removedIds.length ? d.removedIds.map(id=>'  − ' + ((FEATURES.find(f=>f.id===id)||{}).label||id)).join('\n') : '  (ไม่มี)');
  lines.push('');
  lines.push('รายการคุณสมบัติทั้งหมดของ EA ใหม่:');
  FEATURES.forEach(f=>{ lines.push('  [' + (d.newFlags[f.id] ? 'x' : ' ') + '] ' + f.label); });
  lines.push('');
  lines.push('หมายเหตุ: นี่คือใบสเปคสำหรับนำไปพัฒนาโค้ด .mq5 จริงต่อเอง ยังไม่มีผลแบคเทสจริง — หลังพัฒนาและทดสอบใน MT5 Strategy Tester แล้ว ให้อัพโหลดผลเทสจริงเข้าระบบผ่านแท็บ "เปรียบเทียบ EA (ทุกตัว)"');
  if (d.baseSourceCode){
    lines.push('');
    lines.push('--- โค้ดต้นแบบอ้างอิง (' + (d.baseMq5Name||'') + ') — ยังไม่ได้แก้ไข ต้องนำไปปรับเองตามรายการข้างบน ---');
    lines.push(d.baseSourceCode);
  }
  return lines.join('\n');
}
function viewDraftSpec(id){
  const d = eaDrafts.find(x=>x.id===id);
  if (!d) return;
  document.getElementById('draftViewTitle').textContent = d.name + ' — ใบสเปค';
  document.getElementById('draftViewPre').textContent = buildSpecText(d);
  document.getElementById('draftView').classList.add('show');
}
function closeDraftView(){
  const el = document.getElementById('draftView');
  if (el) el.classList.remove('show');
}
async function copyDraftSpec(id){
  const d = eaDrafts.find(x=>x.id===id);
  if (!d) return;
  const text = buildSpecText(d);
  try{
    if (navigator.clipboard && navigator.clipboard.writeText){
      await navigator.clipboard.writeText(text);
      showCreateStatus('คัดลอกใบสเปค "' + d.name + '" แล้ว', true);
    } else throw new Error('no clipboard api');
  } catch(e){
    showCreateStatus('คัดลอกอัตโนมัติไม่สำเร็จ — กด "ดูใบสเปค" แล้วคัดลอกด้วยตัวเองแทน', false);
  }
}
async function deleteDraft(id){
  const backup = eaDrafts;
  eaDrafts = eaDrafts.filter(x=>x.id!==id);
  renderDraftsList();
  const dv = document.getElementById('draftView');
  if (dv && dv.classList.contains('show')) closeDraftView();
  try{ await apiDeleteDraft(id); }
  catch(e){ eaDrafts = backup; renderDraftsList(); showStatus('ลบใบสเปคไม่สำเร็จ: ' + e.message, false); }
}
