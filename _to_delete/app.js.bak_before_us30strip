function renderCmpEqOverlay(sims){
  const legend = document.getElementById('cmpEqLegend');
  legend.innerHTML = sims.map(s=>`<span><span class="dot" style="background:${colorFor(s.code)}"></span>${s.short}</span>`).join('');
  const svg = document.getElementById('cmpEqChart');
  const W = Math.max(svg.parentElement.clientWidth, 700), H = 280;
  const padL = 75, padR = 20, padT = 20, padB = 30;
  svg.setAttribute('width', W); svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
  let minT=Infinity, maxT=-Infinity, minV=Infinity, maxV=-Infinity;
  sims.forEach(s=> s.eqCurve.forEach(pt=>{ if(pt.t<minT)minT=pt.t; if(pt.t>maxT)maxT=pt.t; if(pt.v<minV)minV=pt.v; if(pt.v>maxV)maxV=pt.v; }));
  if (minV>0) minV=0;
  const tRange=(maxT-minT)||1, vRange=(maxV-minV)||1;
  const xScale = t => padL + ((t-minT)/tRange)*(W-padL-padR);
  const yScale = v => (H-padB) - ((v-minV)/vRange)*(H-padT-padB);
  let s = '';
  for(let i=0;i<=4;i++){
    const gy = padT + (H-padT-padB)*i/4;
    const val = maxV - (vRange*i/4);
    s += `<line x1="${padL}" y1="${gy}" x2="${W-padR}" y2="${gy}" stroke="#232c44" stroke-width="1"/>`;
    s += `<text x="${padL-8}" y="${gy+4}" text-anchor="end" font-size="10" fill="#8b95ad">$${Math.round(val).toLocaleString()}</text>`;
  }
  const zeroY = yScale(0);
  if (zeroY>=padT && zeroY<=H-padB) s += `<line x1="${padL}" y1="${zeroY}" x2="${W-padR}" y2="${zeroY}" stroke="#3a4360" stroke-width="1"/>`;
  sims.forEach(sim=>{
    let path='';
    sim.eqCurve.forEach((pt,i)=>{ const x=xScale(pt.t), y=yScale(pt.v); path += (i===0?'M':'L')+x.toFixed(1)+','+y.toFixed(1)+' '; });
    s += `<path d="${path}" fill="none" stroke="${colorFor(sim.code)}" stroke-width="1.8" opacity="0.9"/>`;
  });
  sims.forEach(sim=>{
    if (!sim.maxDDPoint) return;
    const dx = xScale(sim.maxDDPoint.t), dy = yScale(sim.maxDDPoint.v);
    const color = colorFor(sim.code);
    s += `<circle cx="${dx.toFixed(1)}" cy="${dy.toFixed(1)}" r="4" fill="${color}" stroke="#fff" stroke-width="1.2"/>`;
    if (sims.length===1){
      const labelAbove = dy > padT + 16;
      const ly = labelAbove ? dy - 10 : dy + 18;
      s += `<text x="${dx.toFixed(1)}" y="${ly}" text-anchor="middle" font-size="10" font-weight="700" fill="${color}">Max DD</text>`;
    }
  });
  svg.innerHTML = s;
  svg.onmousemove = (ev)=>{
    const rect = svg.getBoundingClientRect();
    const scaleX = W / rect.width;
    const mx = (ev.clientX - rect.left) * scaleX;
    const hoverT = minT + ((mx - padL) / (W-padL-padR)) * tRange;
    if (!sims.length) { hideChartTooltip(); return; }
    let nearestT = null, nearestDiff = Infinity;
    sims.forEach(sim=>{
      sim.eqCurve.forEach(pt=>{
        const diff = Math.abs(pt.t - hoverT);
        if (diff < nearestDiff) { nearestDiff = diff; nearestT = pt.t; }
      });
    });
    if (nearestT === null) { hideChartTooltip(); return; }
    let rows = '';
    sims.forEach(sim=>{
      let closest = sim.eqCurve[0], bestDiff = Infinity;
      sim.eqCurve.forEach(pt=>{ const diff = Math.abs(pt.t - nearestT); if (diff < bestDiff) { bestDiff = diff; closest = pt; } });
      rows += `<div class="tt-row"><span class="tt-dot" style="background:${colorFor(sim.code)}"></span>${sim.short}: <b>${fmt(closest.v)}</b></div>`;
    });
    const html = `<div class="tt-date">${dayKey(nearestT)}</div>${rows}`;
    showChartTooltip(ev.clientX, ev.clientY, html);
  };
  svg.onmouseleave = hideChartTooltip;
}
function renderCmpPeriodTable(sims){
  const bucketed = {};
  sims.forEach(s=>{ bucketed[s.code] = bucketStats(s.trades, KEYFN[cmpPeriodType]); });
  const periods = new Set();
  Object.values(bucketed).forEach(rows=>rows.forEach(r=>periods.add(r.period)));
  let periodList = Array.from(periods).sort();
  const q = document.getElementById('cmpSearchBox').value.trim().toLowerCase();
  if (q) periodList = periodList.filter(p=>p.toLowerCase().includes(q));
  let h = '<thead><tr><th>ช่วงเวลา</th>' + sims.map(s=>`<th>${s.short}</th>`).join('') + '</tr></thead><tbody>';
  periodList.forEach(p=>{
    const vals = sims.map(s=>{
      const byPeriod = {}; bucketed[s.code].forEach(r=>byPeriod[r.period]=r);
      return byPeriod[p] || null;
    });
    const nets = vals.map(v=>v?v.net_profit:null).filter(v=>v!==null);
    const best = nets.length ? Math.max(...nets) : null;
    const worst = nets.length ? Math.min(...nets) : null;
    h += `<tr><td>${p}</td>`;
    vals.forEach(v=>{
      if (!v){ h += '<td class="mono" style="color:var(--muted)">—</td>'; return; }
      const cls = v.net_profit>=0?'pos':'neg';
      const cellCls = v.net_profit===best ? 'best-cell' : (v.net_profit===worst ? 'worst-cell' : '');
      h += `<td class="mono ${cls} ${cellCls}" title="เทรด ${v.trades} • Win ${v.win_rate_pct}% • แพ้ติดกัน ${v.max_consec_losses} ไม้ (${fmt(v.max_consec_losses_dollar)}) • DD $${v.dd_intraperiod}">${fmt(v.net_profit)}</td>`;
    });
    h += '</tr>';
  });
  h += '</tbody>';
  document.getElementById('cmpPeriodTable').innerHTML = h;
}
